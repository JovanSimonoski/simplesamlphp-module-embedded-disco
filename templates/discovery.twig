{% set pagetitle = 'Choose your provider'|trans %}
{% extends "base.twig" %}

{% block preload %}
  {# A stylesheet, not an inline <style> block: SimpleSAMLphp sends
     "Content-Security-Policy: ... style-src 'self'", under which an inline block
     is dropped by the browser and the page renders unstyled. #}
  <link rel="stylesheet" href="{{ asset('css/discovery.css', 'embeddeddisco') }}">
{% endblock %}

{% block content %}
<div class="eds">

  <svg class="eds-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <symbol id="eds-i-search" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    </symbol>
    <symbol id="eds-i-alert" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><path d="M12 16.5h.01"/>
    </symbol>
    <symbol id="eds-i-info" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><path d="M12 7.5h.01"/>
    </symbol>
    <symbol id="eds-i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></symbol>
    <symbol id="eds-i-refresh" viewBox="0 0 24 24">
      <path d="M20 11a8 8 0 10-2.3 6.3"/><path d="M20 5v6h-6"/>
    </symbol>
    <symbol id="eds-i-empty" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/><path d="M8.5 11h5"/>
    </symbol>
    <symbol id="eds-i-arrow" viewBox="0 0 24 24">
      <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
    </symbol>
  </svg>

  <div class="eds-head">
    <h2>{{ pagetitle }}</h2>
    <p class="eds-lede">
      {% trans %}Providers discovered beneath the Trust Anchor of this federation.{% endtrans %}
    </p>
  </div>

  {% if usingMockData %}
    <div class="eds-note eds-note-info">
      <svg class="eds-icon"><use href="#eds-i-info"/></svg>
      <p>{% trans %}Fixture data. No federation is contacted, and selections are not verified.{% endtrans %}</p>
    </div>
  {% endif %}

  {% if discoveryFailed %}
    <div class="eds-note eds-note-danger">
      <svg class="eds-icon"><use href="#eds-i-alert"/></svg>
      <div>
        <p class="eds-note-title">
          {% trans %}The federation could not be read, so no providers can be offered.
          The Trust Anchor is unreachable or is not answering with a valid Entity
          Configuration.{% endtrans %}
        </p>
        {% if discoveryError %}
          <code class="eds-detail">{{ discoveryError }}</code>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <dl class="eds-meta">
    <div>
      <dt>{% trans %}Trust Anchor{% endtrans %}</dt>
      <dd><code title="{{ trustAnchorId }}">{{ trustAnchorId }}</code></dd>
    </div>
    <div>
      <dt>{% trans %}Source{% endtrans %}</dt>
      <dd>
        {% if discoverySource == 'mock' %}
          {% trans %}bundled fixture{% endtrans %}
        {% elseif discoverySource == 'collection_endpoint' %}
          {% trans %}collection endpoint{% endtrans %}
        {% else %}
          {% trans %}federation traversal{% endtrans %}
        {% endif %}
      </dd>
    </div>
    {% if lastUpdated %}
      <div>
        <dt>{% trans %}Discovered{% endtrans %}</dt>
        <dd>{{ lastUpdated|date('Y-m-d H:i') }}</dd>
      </div>
    {% endif %}
    {% if total is not null %}
      <div>
        <dt>{% trans %}Matching{% endtrans %}</dt>
        <dd>{{ total }}</dd>
      </div>
    {% endif %}
    {% if refreshUrl %}
      <div class="eds-meta-action">
        <dt>{% trans %}Cache{% endtrans %}</dt>
        <dd>
          <a href="{{ refreshUrl }}">
            <svg class="eds-icon"><use href="#eds-i-refresh"/></svg>
            {% trans %}Discover again{% endtrans %}
          </a>
        </dd>
      </div>
    {% endif %}
  </dl>

  <form method="get" action="{{ formUrl }}" class="eds-toolbar">
    {% if returnTo %}<input type="hidden" name="ReturnTo" value="{{ returnTo }}">{% endif %}
    {# Searching must not drop the login this page is a step in. #}
    {% if authState %}<input type="hidden" name="AuthState" value="{{ authState }}">{% endif %}

    <div class="eds-field eds-field-grow">
      <label for="eds-query">{% trans %}Search{% endtrans %}</label>
      <div class="eds-search">
        <svg class="eds-icon"><use href="#eds-i-search"/></svg>
        <input type="search" id="eds-query" name="query" value="{{ query }}"
               placeholder="{% trans %}name, organisation or entity ID{% endtrans %}" autofocus>
      </div>
    </div>

    {# No entity type control: only an OpenID Provider can authenticate anyone,
       so which types are offered is configuration (entity_types), not a choice
       to put in front of the person logging in. #}

    <div class="eds-field">
      <label for="eds-sort-dir">{% trans %}Sort{% endtrans %}</label>
      <select id="eds-sort-dir" name="sort_dir">
        <option value="asc"{% if sortOrder == 'asc' %} selected{% endif %}>A &rarr; Z</option>
        <option value="desc"{% if sortOrder == 'desc' %} selected{% endif %}>Z &rarr; A</option>
      </select>
    </div>

    <div class="eds-field">
      <button class="eds-btn eds-btn-primary" type="submit">{% trans %}Apply{% endtrans %}</button>
    </div>
  </form>

  {% if entities|length == 0 %}
    {% if not discoveryFailed %}
      <div class="eds-empty">
        <svg class="eds-icon"><use href="#eds-i-empty"/></svg>
        <p>{% trans %}No providers match these filters.{% endtrans %}</p>
        <a class="eds-btn" href="{{ resetUrl }}">{% trans %}Clear filters{% endtrans %}</a>
      </div>
    {% endif %}
  {% else %}
    <div class="eds-count">
      <span>
        {%- if total is null -%}
          <strong>{{ entities|length }}</strong> {% trans %}shown{% endtrans %}
        {%- else -%}
          <strong>{{ entities|length }}</strong> {% trans %}of{% endtrans %} {{ total }} {% trans %}shown{% endtrans %}
        {%- endif -%}
      </span>
      {% if query or nextPageUrl %}
        <a href="{{ resetUrl }}">{% trans %}Reset{% endtrans %}</a>
      {% endif %}
    </div>

    <ul class="eds-list">
      {% for entity in entities %}
        <li class="eds-item">
          <div class="eds-mark">
            {# The initial sits underneath the logo, so an entity whose logo_uri
               does not resolve falls back to it instead of an empty tile. #}
            <span class="eds-avatar" aria-hidden="true">{{ entity.displayName|slice(0, 1)|upper }}</span>
            {% if entity.logoUri %}
              {# Loaded straight from the provider, so the browser tells it a user is picking.
                 data-initial is what the stylesheet paints if the logo does not load. #}
              <img class="eds-logo" src="{{ entity.logoUri }}" alt=""
                   data-initial="{{ entity.displayName|slice(0, 1)|upper }}"
                   loading="lazy" referrerpolicy="no-referrer">
            {% endif %}
          </div>

          <div class="eds-body">
            <div class="eds-name">{{ entity.displayName }}</div>
            {% if entity.organizationName %}
              <div class="eds-org">{{ entity.organizationName }}</div>
            {% endif %}
            <div class="eds-id" title="{{ entity.entityId }}">{{ entity.entityId }}</div>
            {% if entity.description %}
              <p class="eds-desc">{{ entity.description }}</p>
            {% endif %}
            <div class="eds-tags">
              {% for entityType in entity.entityTypes %}
                <span class="eds-tag">{{ entityType }}</span>
              {% endfor %}
              {% for trustMarkType in entity.trustMarkTypes %}
                {# Claimed, not checked: validating a Trust Mark costs a Trust Chain
                   resolution, which happens once the provider is picked. #}
                <span class="eds-tag eds-tag-mark"
                      title="{% trans %}Claimed Trust Mark, validated on selection{% endtrans %}: {{ trustMarkType }}">
                  <svg class="eds-icon"><use href="#eds-i-check"/></svg>
                  {{ trustMarkType|split('/')|last }}
                </span>
              {% endfor %}
            </div>
          </div>

          <div class="eds-actions">
            <a class="eds-btn eds-btn-primary"
               href="{{ selectUrl }}?entity_id={{ entity.entityId|url_encode }}
                     {%- if returnTo %}&amp;ReturnTo={{ returnTo|url_encode }}{% endif %}
                     {%- if authState %}&amp;AuthState={{ authState|url_encode }}{% endif %}">
              {% trans %}Select{% endtrans %}
            </a>
            {% if entity.informationUri %}
              <a class="eds-info" href="{{ entity.informationUri }}"
                 target="_blank" rel="noopener noreferrer">{% trans %}More info{% endtrans %}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>

    <div class="eds-pager">
      {% if nextPageUrl %}
        <a class="eds-btn" href="{{ nextPageUrl }}">
          {% trans %}Next page{% endtrans %}
          <svg class="eds-icon"><use href="#eds-i-arrow"/></svg>
        </a>
      {% else %}
        <span>{% trans %}End of results.{% endtrans %}</span>
      {% endif %}
    </div>
  {% endif %}

  <p class="eds-foot">
    {% trans %}The same result set is served as an OpenID Federation entity
    collection response at{% endtrans %}
    <a href="{{ entitiesUrl }}"><code>{{ entitiesUrl }}</code></a>
  </p>

</div>
{% endblock %}
