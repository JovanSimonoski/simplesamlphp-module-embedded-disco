{
    "name": "simplesamlphp/simplesamlphp-module-embeddeddisco",
    "description": "Embedded discovery for SimpleSAMLphp, driven by OpenID Federation",
    "type": "simplesamlphp-module",
    "keywords": [ "oidc", "openid-federation", "discovery" ],
    "license": "LGPL-2.1-or-later",
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\embeddeddisco\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimpleSAML\\Test\\Module\\embeddeddisco\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-date": "*",
        "ext-hash": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",

        "simplesamlphp/assert": "^2.0",
        "simplesamlphp/openid": "^0.5",
        "simplesamlphp/simplesamlphp": "^2.5@dev"
    },
    "require-dev": {
        "simplesamlphp/simplesamlphp-test-framework": "^1.11"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "simplesamlphp/composer-module-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
